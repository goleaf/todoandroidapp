{
  "expo": {
    "name": "Ultimate Todo App",
    "slug": "ultimate-todo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "The most feature-complete, productivity-driven task management app with AI, collaboration, and advanced analytics.",
    "keywords": ["todo", "productivity", "tasks", "ai", "collaboration", "pomodoro", "analytics"],
    "primaryColor": "#2196F3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2196F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ultimatetodo.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to attach photos to your tasks.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice commands and voice memos.",
        "NSLocationWhenInUseUsageDescription": "This app uses location to provide location-based task reminders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to provide location-based task reminders even when the app is in the background.",
        "NSCalendarsUsageDescription": "This app can sync your tasks with your calendar.",
        "NSContactsUsageDescription": "This app can access contacts for team collaboration features.",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition for voice commands.",
        "UIBackgroundModes": ["background-fetch", "background-processing", "location"]
      },
      "associatedDomains": ["applinks:ultimatetodo.app"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2196F3"
      },
      "package": "com.ultimatetodo.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CONTACTS",
        "VIBRATE",
        "USE_FINGERPRINT",
        "USE_BIOMETRIC",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "ultimatetodo.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Ultimate Todo App",
      "shortName": "UltimateTodo",
      "lang": "en",
      "scope": "/",
      "themeColor": "#2196F3",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "crossorigin": "use-credentials"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#2196F3",
      "sounds": ["./assets/sounds/notification.wav"],
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new tasks"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "hooks": {
      "postPublish": [
        {
          "file": "sentry-expo/upload-sourcemaps",
          "config": {
            "organization": "your-org",
            "project": "ultimate-todo-app"
          }
        }
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-camera",
      "expo-av",
      "expo-location",
      "expo-calendar",
      "expo-contacts",
      "expo-document-picker",
      "expo-local-authentication",
      "expo-speech",
      "expo-sqlite",
      "expo-file-system",
      "expo-sharing",
      "expo-image-picker",
      "expo-haptics",
      "expo-sensors",
      "expo-task-manager",
      "expo-background-fetch",
      [
        "react-native-vector-icons",
        {
          "fonts": ["MaterialIcons", "MaterialCommunityIcons", "Ionicons", "FontAwesome", "Feather"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "minSdkVersion": 21,
            "proguardMinifyEnabled": true,
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "13.0"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app uses location to provide location-based task reminders.",
          "locationAlwaysPermission": "This app uses location to provide location-based task reminders even when the app is in the background.",
          "locationWhenInUsePermission": "This app uses location to provide location-based task reminders.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2196F3",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "This app uses Face ID for secure authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}